   "source": [
    "no=int(input(\"enter no\"))\n",
    "count=0\n",
    "for i in range(1,no+1):\n",
    "    if no%i==0:\n",
    "        count+=1\n",
    "if count==2:\n",
    "    print(no,\"is prime\")\n",
    "else:\n",
    "    print(no,\"no is not prime\")"
   ]
